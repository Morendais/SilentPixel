<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md3_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Pixel Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="32sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textColor="@color/md3_text_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:textSize="14sp"
            android:textColor="@color/md3_text_body"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <!-- Main Switch Card (Pixel Hero Style) -->
        <LinearLayout
            android:id="@+id/cardMainSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_single"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvSwitchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_mute_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/md3_text_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_mute_desc"
                    android:textSize="13sp"
                    android:textColor="@color/md3_text_body"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/switchMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:thumbTint="@color/md3_switch_thumb_checked"
                android:trackTint="@color/md3_switch_track_checked" />

        </LinearLayout>

        <!-- Section Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_preferences"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/md3_primary"
            android:letterSpacing="0.08"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp" />

        <!-- Settings Group Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_single"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <!-- Item 1: Auto Silence on Restart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_boot_title"
                        android:textSize="15sp"
                        android:textColor="@color/md3_text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_boot_desc"
                        android:textSize="12sp"
                        android:textColor="@color/md3_text_body"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/switchBoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md3_divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <!-- Item 2: Battery Optimization -->
            <LinearLayout
                android:id="@+id/rowBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_battery_title"
                    android:textSize="15sp"
                    android:textColor="@color/md3_text_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_battery_desc"
                    android:textSize="12sp"
                    android:textColor="@color/md3_text_body"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md3_divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <!-- Item 3: Quick Settings Tile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_tile_title"
                    android:textSize="15sp"
                    android:textColor="@color/md3_text_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_tile_desc"
                    android:textSize="12sp"
                    android:textColor="@color/md3_text_body"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Footer / Status Info -->
        <TextView
            android:id="@+id/tvEngineInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/status_sku"
            android:textSize="12sp"
            android:textColor="@color/md3_text_muted"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
