<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md3_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="88dp"
        android:paddingBottom="24dp">

        <!-- Pixel Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="32sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textColor="@color/md3_text_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:textSize="14sp"
            android:textColor="@color/md3_text_body"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <!-- Hero Action Card (Google Pixel Style) -->
        <LinearLayout
            android:id="@+id/cardMainAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_single"
            android:padding="22dp"
            android:layout_marginBottom="28dp">

            <!-- Top Row: Title + Status Chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/card_mute_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md3_text_title" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_active"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/status_silenced"
                    android:textColor="@color/md3_status_active_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/card_mute_desc"
                android:textSize="13sp"
                android:textColor="@color/md3_text_body"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp" />

            <!-- One-tap Action Button -->
            <Button
                android:id="@+id/btnSilence"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_pill"
                android:text="@string/btn_silence_shutter"
                android:textColor="@color/md3_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Section Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_preferences"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/md3_primary"
            android:letterSpacing="0.08"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp" />

        <!-- Settings Group Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_single"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <!-- Item 1: Quick Settings Tile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_tile_title"
                    android:textSize="15sp"
                    android:textColor="@color/md3_text_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_tile_desc"
                    android:textSize="12sp"
                    android:textColor="@color/md3_text_body"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md3_divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <!-- Item 2: GitHub Repository Link -->
            <LinearLayout
                android:id="@+id/rowGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_github_title"
                    android:textSize="15sp"
                    android:textColor="@color/md3_text_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_github_desc"
                    android:textSize="12sp"
                    android:textColor="@color/md3_primary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
